# Backend URL (leave empty for same-origin proxy)
VITE_API_URL=http://localhost:8000/api

# Google Cloud OAuth 2.0 Client ID (required for Google Forms export)
# Setup: console.cloud.google.com → APIs → Google Forms API → Credentials → OAuth 2.0 Client ID
# Authorized origins: http://localhost:3001, https://your-domain.vercel.app
VITE_GOOGLE_CLIENT_ID=
